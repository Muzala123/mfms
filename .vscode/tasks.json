{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MFMS",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c99",
                "-Wall",
                "-Wextra",
                "-Isrc",
                "-o",
                "mfms",
                "src/main.c",
                "src/common.c",
                "src/employees.c",
                "src/budget.c",
                "src/suppliers.c",
                "src/assets.c",
                "src/reports.c"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run MFMS",
            "type": "shell",
            "command": "./mfms",
            "dependsOn": [
                "Build MFMS"
            ],
            "problemMatcher": []
        }
    ]
}
